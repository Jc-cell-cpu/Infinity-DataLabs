# --- Contact form email (Gmail SMTP) ---
# The Gmail address that sends the notification, plus a Google *App Password*
# (NOT your normal password). App passwords require 2-Step Verification, then
# are created at https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASSWORD=
# Inbox where inquiries are delivered. Leave blank to use SMTP_USER.
CONTACT_TO=
# Optional: override for a non-Gmail SMTP provider (defaults to Gmail).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Optional: forward submissions to a CRM/webhook instead of (or in addition to
# falling back from) email.
CONTACT_WEBHOOK_URL=
